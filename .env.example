# Public Google Apps Script Web App URL.
# This URL is public configuration (not a password). Required so every guest device
# can load shared photos/audio and submit RSVP. Keep the same URL in Vercel/Netlify env.
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional legacy AI Studio values (not used by the invitation guest flow).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
